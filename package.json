  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
