{
  "name": "agentshield",
  "version": "1.0.0",
  "description": "AgentShield: Runtime security, authorization, and control platform for AI agents",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "node scripts/dev.js",
    "test": "node --test server/tests/*.test.js",
    "build": "npm --prefix client run build",
    "seed": "node server/src/db/seed.js"
  },
  "keywords": [
    "ai-agent-security",
    "policy-engine",
    "runtime-authorization",
    "guardrails",
    "voice-security",
    "gnani-ai"
  ],
