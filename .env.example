# AgentShield Environment Configuration

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Persistence
DATABASE_PATH=./data/agentshield.sqlite

# Security & Sessions
JWT_SECRET=demo-secret-agentshield-security-token-do-not-use-in-prod
VERIFICATION_CODE_EXPIRY_SECONDS=300
IDEMPOTENCY_WINDOW_SECONDS=86400

# AI Provider Selection (mock | gnani | openai | deterministic)
AI_MODEL_PROVIDER=deterministic
OPENAI_API_KEY=

# Gnani Voice & Reasoning Platform (vachana.ai)
GNANI_ENABLED=false
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=wss://api.vachana.ai/api/v1/tts
GNANI_MODEL_STT=prisma-v2.5
GNANI_MODEL_TTS=timbre-v2.5
GNANI_MODEL_LLM=evon-v3.3

# Credit Budget Guard (Conservative Protection)
GNANI_CREDIT_BUDGET=5000
GNANI_CREDIT_RESERVE=1000
GNANI_AUTO_RETRY=false
